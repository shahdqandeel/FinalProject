<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="@color/white">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:src="@drawable/baseline_arrow_back_ios_24"
            app:tint="@color/black"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/payment_methods"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/tv_add_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/add_new"
            android:textColor="@color/purple_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_credit_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quantity_counter"
        android:backgroundTint="@color/product_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp">
        <ImageView
            android:id="@+id/iv_card_icon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:src="@drawable/img_credit_card" />
        <TextView
            android:id="@+id/tv_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credit_card"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_toRightOf="@id/iv_card_icon"
            android:layout_toLeftOf="@+id/tv_default_badge"
            android:layout_marginLeft="12dp" />
        <TextView
            android:id="@+id/tv_card_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_num"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_below="@id/tv_card_title"
            android:layout_toRightOf="@id/iv_card_icon"
            android:layout_toLeftOf="@+id/iv_visa_logo"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visa_num"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:layout_below="@id/tv_card_number"
            android:layout_toRightOf="@id/iv_card_icon"
            android:layout_toLeftOf="@+id/iv_visa_logo"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp" />
        <ImageView
            android:id="@+id/iv_arrow_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/gray_text" />
        <TextView
            android:id="@+id/tv_default_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/defaut"
            android:textSize="11sp"
            android:textColor="@color/purple_primary"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_toLeftOf="@id/iv_arrow_1"
            android:layout_marginRight="8dp"
            android:layout_alignParentTop="true" />
        <ImageView
            android:id="@+id/iv_visa_logo"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:src="@drawable/img_visa"
            android:layout_toLeftOf="@id/iv_arrow_1"
            android:layout_below="@id/tv_default_badge"
            android:layout_marginRight="8dp"
            android:layout_marginTop="8dp" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_paypal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quantity_counter"
        android:backgroundTint="@color/product_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp">
        <ImageView
            android:id="@+id/iv_paypal_icon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:src="@drawable/img_paypal_icon" />
        <TextView
            android:id="@+id/tv_paypal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paypal"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_toRightOf="@id/iv_paypal_icon"
            android:layout_toLeftOf="@+id/iv_paypal_logo"
            android:layout_marginLeft="12dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/john_email"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:layout_below="@id/tv_paypal_title"
            android:layout_toRightOf="@id/iv_paypal_icon"
            android:layout_toLeftOf="@+id/iv_paypal_logo"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp" />
        <ImageView
            android:id="@+id/iv_arrow_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/gray_text" />
        <ImageView
            android:id="@+id/iv_paypal_logo"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:src="@drawable/img_paypal"
            android:layout_toLeftOf="@id/iv_arrow_2"
            android:layout_centerVertical="true"
            android:layout_marginRight="8dp" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_cash_on_delivery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quantity_counter"
        android:backgroundTint="@color/product_bg"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp">
        <ImageView
            android:id="@+id/iv_cash_icon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:src="@drawable/img_cash" />
        <TextView
            android:id="@+id/tv_cash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cash_on_delivery"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_toRightOf="@id/iv_cash_icon"
            android:layout_toLeftOf="@+id/iv_arrow_3"
            android:layout_marginLeft="12dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pay"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:layout_below="@id/tv_cash_title"
            android:layout_toRightOf="@id/iv_cash_icon"
            android:layout_toLeftOf="@+id/iv_arrow_3"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp" />
        <ImageView
            android:id="@+id/iv_arrow_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/gray_text" />
    </RelativeLayout>
    </LinearLayout>
    <fragment
        android:id="@+id/bottomNavigationFragment"
        android:name="com.example.e_commerceapp.fragments.BottomNavigationFragment"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        tools:layout="@layout/activity_bottom_navigation_fragment"/>
</LinearLayout>
