<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/scroll_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigationFragment"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Header -->

            <LinearLayout
                android:id="@+id/layout_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/purple_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_notification"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_notification" />

            </LinearLayout>

            <!-- Search -->

            <LinearLayout
                android:id="@+id/layout_search"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/hint_gray"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/iv_filter"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_filter" />

            </LinearLayout>

            <!-- Banner -->

            <RelativeLayout
                android:id="@+id/layout_banner"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:background="@color/purple_dark"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/layout_banner_text"
                    android:layout_width="190dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_banner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mega_sale"
                        android:textColor="@color/yellow"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_banner_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/discount_title"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_banner_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_subtitle"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_shop_now"
                        android:layout_width="95dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/white"
                        android:text="@string/shop_now"
                        android:textAllCaps="false"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_banner_image"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/gift_bag" />

                <TextView
                    android:id="@+id/tv_banner_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:text="@string/banner_dots"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

            </RelativeLayout>

            <!-- Categories header -->

            <RelativeLayout
                android:id="@+id/layout_categories_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/tv_categories_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categories"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_categories_see_all"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/see_all"
                    android:textColor="@color/purple_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Categories -->

            <HorizontalScrollView
                android:id="@+id/scroll_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Electronics -->

                    <LinearLayout
                        android:id="@+id/layout_category_electronics"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_category_electronics"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_electronics" />

                        <TextView
                            android:id="@+id/tv_category_electronics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/electronics"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Fashion -->

                    <LinearLayout
                        android:id="@+id/layout_category_fashion"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_category_fashion"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_fashion" />

                        <TextView
                            android:id="@+id/tv_category_fashion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/fashion"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Shoes -->

                    <LinearLayout
                        android:id="@+id/layout_category_shoes"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_category_shoes"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_shoes" />

                        <TextView
                            android:id="@+id/tv_category_shoes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/shoes"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Beauty -->

                    <LinearLayout
                        android:id="@+id/layout_category_beauty"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_category_beauty"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_beauty" />

                        <TextView
                            android:id="@+id/tv_category_beauty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/beauty"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Accessories -->

                    <LinearLayout
                        android:id="@+id/layout_category_accessories"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_category_accessories"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_category_accessories" />

                        <TextView
                            android:id="@+id/tv_category_accessories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/accessories"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Home -->

                    <LinearLayout
                        android:id="@+id/layout_category_home"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv_category_home"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:contentDescription="@null"
                            android:src="@drawable/category_home" />

                        <TextView
                            android:id="@+id/tv_category_home"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/home"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Featured Products header -->

            <RelativeLayout
                android:id="@+id/layout_featured_products_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/tv_featured_products_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/featured_products"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_featured_products_see_all"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/see_all"
                    android:textColor="@color/purple_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Products -->

            <LinearLayout
                android:id="@+id/layout_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <!-- Row one -->

                <LinearLayout
                    android:id="@+id/layout_products_row_one"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- iPhone -->

                    <LinearLayout
                        android:id="@+id/layout_product_iphone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@color/product_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/iv_product_iphone"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_iphone" />

                        <TextView
                            android:id="@+id/tv_product_iphone_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/iphone"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_product_iphone_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_product_iphone_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/iphone_price"
                                android:textColor="@color/black"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_product_iphone_star"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/tv_product_iphone_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/iphone_rating"
                                android:textColor="@color/gray_text"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Headphone -->

                    <LinearLayout
                        android:id="@+id/layout_product_headphone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@color/product_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/iv_product_headphone"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/product_headphone" />

                        <TextView
                            android:id="@+id/tv_product_headphone_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/headphone"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_product_headphone_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_product_headphone_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/headphone_price"
                                android:textColor="@color/black"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_product_headphone_star"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/tv_product_headphone_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/headphone_rating"
                                android:textColor="@color/gray_text"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sunglasses -->

                    <LinearLayout
                        android:id="@+id/layout_product_sunglasses"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@color/product_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/iv_product_sunglasses"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/product_sunglasses" />

                        <TextView
                            android:id="@+id/tv_product_sunglasses_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/sunglasses"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_product_sunglasses_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_product_sunglasses_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sunglasses_price"
                                android:textColor="@color/black"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_product_sunglasses_star"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/tv_product_sunglasses_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/sunglasses_rating"
                                android:textColor="@color/gray_text"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Row two -->

                <LinearLayout
                    android:id="@+id/layout_products_row_two"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Dress -->

                    <LinearLayout
                        android:id="@+id/layout_product_dress"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@color/product_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/iv_product_dress"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/product_dress" />

                        <TextView
                            android:id="@+id/tv_product_dress_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dress"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_product_dress_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_product_dress_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dress_price"
                                android:textColor="@color/black"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_product_dress_star"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/tv_product_dress_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/dress_rating"
                                android:textColor="@color/gray_text"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Shoes -->

                    <LinearLayout
                        android:id="@+id/layout_product_shoes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@color/product_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/iv_product_shoes"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/product_shoes" />

                        <TextView
                            android:id="@+id/tv_product_shoes_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/sport_shoes"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_product_shoes_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_product_shoes_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/shoes_price"
                                android:textColor="@color/black"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_product_shoes_star"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/tv_product_shoes_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/shoes_rating"
                                android:textColor="@color/gray_text"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Beauty -->

                    <LinearLayout
                        android:id="@+id/layout_product_beauty"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="@color/product_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/iv_product_beauty"
                            android:layout_width="match_parent"
                            android:layout_height="98dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/product_beauty" />

                        <TextView
                            android:id="@+id/tv_product_beauty_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/beauty_product"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_product_beauty_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_product_beauty_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/beauty_price"
                                android:textColor="@color/black"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_product_beauty_star"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/tv_product_beauty_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/beauty_rating"
                                android:textColor="@color/gray_text"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/view_bottom_space"
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>

    </ScrollView>

    <fragment
        android:id="@+id/bottomNavigationFragment"
        android:name="com.example.e_commerceapp.fragments.BottomNavigationFragment"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        tools:layout="@layout/fragment_bottom_navigation"/>
</RelativeLayout>